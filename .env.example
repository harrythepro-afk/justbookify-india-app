# Copy to .env.local and fill in values for the development store.
# EXPO_PUBLIC_ values are bundled into the app and readable by anyone who installs it.
# Never put a secret here. See docs/SHOPIFY_INTEGRATION.md for what may ship in the app.

# Shop domain without scheme or path (the store's myshopify.com domain)
EXPO_PUBLIC_STORE_DOMAIN=
# Storefront API PUBLIC access token from the Headless channel. Never the private token,
# never an Admin API token (the config refuses shpat_, shpss_ and similar prefixes).
EXPO_PUBLIC_STOREFRONT_ACCESS_TOKEN=
# ISO 4217 currency code; must match the store's own currency (npm run check:dev-store)
EXPO_PUBLIC_STORE_CURRENCY=
# Buyer context sent with every Storefront API operation (D-058): ISO 3166-1 two-letter
# country code (IN for India) and Shopify language code (EN). check:dev-store confirms that
# Shopify resolves them to the currency above
EXPO_PUBLIC_STORE_COUNTRY=
EXPO_PUBLIC_STORE_LANGUAGE=
# Flat shipping fee, prepaid orders (major units, e.g. 12.50)
EXPO_PUBLIC_SHIPPING_FEE_PREPAID=
# Flat shipping fee, cash on delivery (major units). A cart hint only: checkout sets the
# final amount. The ACOD app adds no fee of its own (D-031)
EXPO_PUBLIC_SHIPPING_FEE_COD=
# Subtotal from which delivery is free (major units)
EXPO_PUBLIC_FREE_DELIVERY_THRESHOLD=
# Automatic shipping discount taken off either delivery rate from the threshold above (major
# units; 75 for the India store, D-031, D-141). A cart hint only: checkout sets the final amount
EXPO_PUBLIC_SHIPPING_DISCOUNT=
# Checkout is blocked when the cart subtotal reaches this value (major units)
EXPO_PUBLIC_ORDER_CAP=
# Two-digit pincode prefix ranges, comma separated (e.g. 10-13,20)
EXPO_PUBLIC_DELIVERY_PINCODE_RANGES=

# Login with the store's customer account (P7-01, D-120), from the Headless channel's Customer
# Account API settings (public, mobile client type). The client ID is public: a public client
# has no secret. The shop ID (digits only) names the callback scheme shop.<shop ID>.app; it is
# compiled into the build, so on EAS it is also an environment variable of the build's
# environment. Both empty means login is not set up on this build.
EXPO_PUBLIC_CUSTOMER_ACCOUNT_CLIENT_ID=
EXPO_PUBLIC_SHOP_ID=

# Sentry DSN for crash reports (D-042). Public by design: it only lets the app send events.
# Empty means crash reporting is off. Never put the Sentry auth token here; it lives in EAS only.
EXPO_PUBLIC_SENTRY_DSN=

# Our backend (P10-02, D-166): the Cloud Functions base URL of the development Firebase project,
# https://asia-south1-<project ID>.cloudfunctions.net (no path). Public: every request is checked
# with the customer's own token on the backend. Read by development builds only; leave it unset
# for staging and production. Empty means Home's "Backend: check" shows "not configured".
EXPO_PUBLIC_BACKEND_URL=
