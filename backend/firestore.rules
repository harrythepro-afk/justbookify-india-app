rules_version = '2';

// The app never talks to Firestore directly (D-163). Only the backend's functions use it, through
// the Admin SDK, which these rules do not apply to. Every client read and write is refused.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
