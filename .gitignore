sentry.properties

# service-account and cloud credential files
*service-account*.json
*serviceAccount*.json
*-adminsdk-*.json
firebase-key*.json
.firebase/
.runtimeconfig.json

# Firebase app config files: kept out of git, supplied to EAS builds as the file variable
